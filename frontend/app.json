{
  "expo": {
    "name": "Community Problem Reporter",
    "slug": "frontend-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.community.problemreporter2",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b5919a01-f1e9-4d28-a3b7-09f736accd92"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to use your location to report civic issues."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to use your camera to take photos of civic issues."
        }
      ],
      "expo-image-picker",
      "expo-notifications"
    ],
    "owner": "gaganesh2196"
  }
}
